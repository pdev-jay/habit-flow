{
  "expo": {
    "name": "habit-flow",
    "slug": "habit-flow",
    "version": "1.0.0",
    "scheme": "habit-flow",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/crashlytics",
        {
          "ios": {
            "isCrashlyticsCollectionEnabled": true
          },
          "android": {
            "isCrashlyticsCollectionEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jkim-1101.habitflow",
      "googleServicesFile": "./ios/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSPhotoLibraryAddUsageDescription": "습관 통계 이미지를 저장하기 위해 사진 라이브러리 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "습관 통계 이미지를 저장하기 위해 사진 라이브러리 접근 권한이 필요합니다."
      },
      "deploymentTarget": "16.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./android/google-services.json",
      "package": "com.pdevjay.habitflow",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52291573-6372-4af3-9a40-992504b554f0"
      }
    }
  }
}