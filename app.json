{
  "expo": {
    "name": "Routimeter",
    "slug": "routimeter",
    "version": "1.0.0",
    "scheme": "routimeter",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/crashlytics",
        {
          "ios": {
            "isCrashlyticsCollectionEnabled": true
          },
          "android": {
            "isCrashlyticsCollectionEnabled": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3699725475270623~2107191451"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#334156"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pdevjay.routimeter",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSPhotoLibraryAddUsageDescription": "습관 통계 이미지를 저장하기 위해 사진 라이브러리 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "습관 통계 이미지를 저장하기 위해 사진 라이브러리 접근 권한이 필요합니다."
      },
      "deploymentTarget": "16.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./android/google-services.json",
      "package": "com.pdevjay.routimeter",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "updates": {
      "url": "https://u.expo.dev/65b23542-e3c6-4068-a8ab-e4b64a7f2c46"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65b23542-e3c6-4068-a8ab-e4b64a7f2c46"
      },
      "admob": {
        "iosRewardedAdUnitId": "ca-app-pub-3699725475270623/4267107478",
        "androidRewardedAdUnitId": "ca-app-pub-3940256099942544/5224354917"
      }
    }
  }
}